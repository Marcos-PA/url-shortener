# Dev: SQLite local, zero setup.
DATABASE_URL=sqlite:///./app.db
# Produção (Supabase > Connect > Session pooler), cole a URL como vem:
# DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
CORS_ORIGINS=["http://localhost:5173"]
# Where short links point to. Production: the Render URL, e.g. https://my-app-api.onrender.com
PUBLIC_BASE_URL=http://localhost:8000
